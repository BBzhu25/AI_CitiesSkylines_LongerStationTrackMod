<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <!-- ===== 通用属性 ===== -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{8F3B2A1E-7C4D-4E5A-9B6F-1234567890AB}</ProjectGuid>
    <ProjectTypeGuids>{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC};{60dc8134-eba5-43b8-bcc9-bb4bc16c2548}</ProjectTypeGuids>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>LongerStationTrackMod</RootNamespace>
    <AssemblyName>LongerStationTrackMod</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <TargetFrameworkProfile />
  </PropertyGroup>

  <!-- ===== 本机路径（CS1 装在别处就只改 GamePath 这一行）===== -->
  <PropertyGroup>
    <GamePath Condition="'$(GamePath)' == ''">D:\SteamLibrary\steamapps\common\Cities_Skylines</GamePath>
    <ManagedPath>$(GamePath)\Cities_Data\Managed</ManagedPath>
    <ModsFolder>$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Addons\Mods\LongerStationTrackMod</ModsFolder>
  </PropertyGroup>

  <!-- ===== Debug | x64 ===== -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- ===== Release | x64 ===== -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- ===== 程序集引用：游戏 DLL 不复制(Private=false)，0Harmony 随 mod 发布(Private=true) ===== -->
  <ItemGroup>
    <Reference Include="ICities">
      <HintPath>$(ManagedPath)\ICities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ColossalManaged">
      <HintPath>$(ManagedPath)\ColossalManaged.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 0Harmony 仅编译期引用 (Private=false)，不随 mod 发布。
         运行时由 CitiesHarmony(创意工坊 2040656402) 统一提供 0Harmony 2.0.4.0，
         这是 CS1 mod 生态的标准做法，私带 0Harmony 会导致双运行时硬闪退。 -->
    <Reference Include="0Harmony">
      <HintPath>Libs\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- ===== 源码 ===== -->
  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Source\Mod.cs" />
    <Compile Include="Source\Patches.cs" />
  </ItemGroup>

  <!-- 注意：CSharp.targets 必须放最底部导入 -->
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- ===== 编译成功后自动部署到 CS1 的 Mods 目录 ===== -->
  <Target Name="AfterBuild">
    <MakeDir Directories="$(ModsFolder)" Condition="!Exists('$(ModsFolder)')" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsFolder)" />
    <Copy SourceFiles="$(TargetDir)0Harmony.dll" DestinationFolder="$(ModsFolder)" Condition="Exists('$(TargetDir)0Harmony.dll')" />
  </Target>
</Project>
